# Wallet that receives payments. Sales stay closed until it is set.
# Use a wallet you control and nothing else pays into; friendly (UQ…/EQ…) or raw form.
TREASURY_ADDRESS=

# mainnet (default) or testnet
TON_NETWORK=mainnet

# Sheet size in pixels and prices in GRAM.
GRID_W=1000
GRID_H=1000
PRICE_PER_PIXEL=1
EDIT_FEE=0.1

# Largest single purchase.
MAX_SIDE=200
MAX_AREA=10000

# Extra moderator wallets, comma separated. The treasury wallet is always a moderator.
ADMIN_ADDRESSES=

# Optional API keys for the chain indexers. Without them the public rate limits apply.
TONCENTER_API_KEY=
TONAPI_KEY=

# Optional link shown in the menu.
TELEGRAM_URL=

# Set automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Optional: codes for confirming the site in webmaster tools by meta tag.
# Not needed when the site is confirmed through DNS.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_SITE_VERIFICATION=
